# ─── 面基投资系统 Environment Variables ───
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Feishu/Lark Bot Credentials (for doc creation & group push)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_FOLDER_TOKEN=your_folder_token_here
FEISHU_USER_OPENID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ARK API Key (for GLM-4-Flash news analysis)
ARK_API_KEY=your_ark_api_key_here

# Finnhub API Key (for US stock realtime quote; free tier 60 calls/min)
# 美股实时报价(免费60次/分钟); 无 key 自动降级 yfinance
FINNHUB_API_KEY=your_finnhub_api_key_here

# Hermes Gateway (if running locally)
FEISHU_PLATFORM_TOKEN=your_platform_token_here
